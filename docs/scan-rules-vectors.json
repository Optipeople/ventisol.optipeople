      "now": "2026-10-21T10:00:00Z", "todayStart": "2026-10-20T22:00:00Z", "windowStart": "2026-10-19T22:00:00Z",
      "events": [
        { "id": "00000000-0000-0000-0009-000000000001", "barcode": "058556050103", "stationNo": 1, "station": "Station 10", "stationKind": "Assembly", "direction": "In", "time": "2026-10-21T06:00:00Z", "durationSec": null },
        { "id": "00000000-0000-0000-0009-000000000002", "barcode": "058556050103", "stationNo": 1, "station": "Station 10", "stationKind": "Assembly", "direction": "Out", "time": "2026-10-21T06:10:00Z", "durationSec": 600 },
        { "id": "00000000-0000-0000-0009-000000000003", "barcode": "058556050103", "stationNo": 1, "station": "Station 10", "stationKind": "Assembly", "direction": "In", "time": "2026-10-21T06:30:00Z", "durationSec": null },
        { "id": "00000000-0000-0000-0009-000000000004", "barcode": "058556050103", "stationNo": 1, "station": "Station 10", "stationKind": "Assembly", "direction": "Out", "time": "2026-10-21T06:35:00Z", "durationSec": 300 }
