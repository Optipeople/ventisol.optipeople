<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Company>Optipeople</Company>
    <Product>Ventisol MES-skærm</Product>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Every package, direct or pulled in, is pinned by version and content hash in packages.lock.json
         beside each project. After adding or updating a package, run dotnet restore and commit the lock
         files. On the build servers (CI is set there) a restore that does not match them fails. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- The release is published for win-x64 and win-x86 (32-bit Windows), and a publish restores the projects it references for
         that runtime as well: naming it here puts it in every lock file, so that restore is locked too. -->
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
