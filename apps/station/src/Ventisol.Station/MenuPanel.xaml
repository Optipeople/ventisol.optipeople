<!-- Opens from the logo. Anyone may look: version, connection, updates, scanners.
     The layout is open to all. The setup asks for the setup PIN when one is set (in the setup itself);
     the window does the asking. DataContext is the MainViewModel. -->
<UserControl x:Class="Ventisol.Station.MenuPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ventisol.Station.ViewModels"
             xmlns:local="clr-namespace:Ventisol.Station">
    <UserControl.Resources>
        <Style x:Key="Left" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Left}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Kicker}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
            <Setter Property="Margin" Value="0,36,0,8" />
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,13" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="36,32,36,32">
        <DockPanel DockPanel.Dock="Top">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="44" Height="44" Cursor="Hand" Focusable="False"
                    ToolTip="Luk" Click="OnClose">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xE8BB;"
                                       Foreground="{StaticResource Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Rule}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Image Source="{StaticResource OptipeopleLogoWhite}" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Setup: behind the setup PIN when one is set, open until then -->
        <Button DockPanel.Dock="Bottom" Cursor="Hand" Focusable="False" Click="OnSetup" ToolTip="Opsætning">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="8" Background="{StaticResource Rule}" Padding="20,16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Text="&#xE713;"
                                       Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Left}" FontWeight="Bold" Text="Opsætning" />
                                <TextBlock Style="{StaticResource Left}" FontSize="15" Foreground="{StaticResource Ink3}"
                                           Text="OptiCloud, stationer og scannere" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Layout: open to all -->
        <Button DockPanel.Dock="Bottom" Margin="0,0,0,12" Cursor="Hand" Focusable="False" Click="OnArrange" ToolTip="Tilpas layout">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="8" Background="{StaticResource Rule}" Padding="20,16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Text="&#xE80A;"
                                       Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Left}" FontWeight="Bold" Text="Tilpas layout" />
                                <TextBlock Style="{StaticResource Left}" FontSize="15" Foreground="{StaticResource Ink3}"
                                           Text="Flyt og skift størrelse på stationerne" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <!-- Right margin keeps values clear of the scrollbar when the list overflows -->
            <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource Section}" Text="SKÆRM" />
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" FontFamily="{StaticResource Mono}" Text="{Binding Version}" />
                        <TextBlock Style="{StaticResource Left}" Text="Version" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding RoleText, Mode=OneTime}" />
                        <TextBlock Style="{StaticResource Left}" Text="Rolle" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,1,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Warn}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CloudHealth}" Value="Ok">
                                                <Setter Property="Fill" Value="{StaticResource Ok}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CloudHealth}" Value="Alarm">
                                                <Setter Property="Fill" Value="{StaticResource Alarm}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <!-- Wraps rather than trims: an error is only of use when it can be read to the end -->
                            <TextBlock Style="{StaticResource Value}" Text="{Binding CloudText}" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="300" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Left}" Text="OptiCloud" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding UpdateText}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                        <TextBlock Style="{StaticResource Left}" Text="Opdateringer" />
                    </DockPanel>
                </Border>

                <TextBlock Style="{StaticResource Section}" Text="SCANNERE"
                           Visibility="{Binding ShowsScanners, Mode=OneTime, Converter={x:Static vm:Present.Instance}}" />
                <ItemsControl ItemsSource="{Binding Stations}"
                              Visibility="{Binding ShowsScanners, Mode=OneTime, Converter={x:Static vm:Present.Instance}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StationViewModel}">
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <TextBlock x:Name="State" DockPanel.Dock="Right" Style="{StaticResource Value}" Text="Klar" />
                                    <Viewbox Width="18" Height="18" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <local:StatusDot x:Name="Dot" Fill="{StaticResource Ok}" />
                                    </Viewbox>
                                    <TextBlock Style="{StaticResource Left}">
                                        <Run Text="Scanner" /> <Run Text="{Binding Number, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource Quiet}" /><Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Ink3}" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ScannerConnected}" Value="False">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Alarm}" />
                                    <Setter TargetName="State" Property="Text" Value="Mangler" />
                                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource AlarmText}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
