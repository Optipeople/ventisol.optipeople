<!-- Shown while a start waits after failed ones (App.WaitThenOpen): the app is on its way, and
     "Start nu" ends the wait. Small, in front, and never the only thing keeping the app alive. -->
<Window x:Class="Ventisol.Station.StartNotice"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ventisol MES-skærm" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        Background="{StaticResource Panel}" FontFamily="{StaticResource Hanken}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="44,38,44,40">
        <StackPanel>
            <TextBlock Style="{StaticResource Kicker}" FontSize="15" HorizontalAlignment="Left" Text="VENTISOL STATION" />
            <TextBlock x:Name="Headline" Style="{StaticResource TextBase}" HorizontalAlignment="Left" TextAlignment="Left"
                       FontSize="40" FontWeight="Bold" Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource TextBase}" HorizontalAlignment="Left" TextAlignment="Left"
                       FontSize="22" Foreground="{StaticResource Ink3}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Appen blev genstartet efter en fejl." />
            <Button Style="{StaticResource ConfirmButton}" HorizontalAlignment="Right" Margin="0,36,0,0" Content="Start nu"
                    Foreground="{StaticResource Dark}" Background="{StaticResource Ok}" Click="OnStartNow" />
        </StackPanel>
    </Border>
</Window>
