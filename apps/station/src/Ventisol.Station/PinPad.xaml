<!-- Asks for the setup PIN: a card over a dimmed screen, like the stop confirm, with keys big enough
     for a thumb. A keyboard works too (the window passes its digits, Enter, Backspace and Esc on). -->
<UserControl x:Class="Ventisol.Station.PinPad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <UserControl.Resources>
        <!-- A key: the confirm's button, square -->
        <Style x:Key="Key" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Rule}" />
            <Setter Property="FontFamily" Value="{StaticResource Hanken}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Takes every tap beside the card, so nothing under it is hit; closing is "Annuller" or Esc -->
        <Border Background="#99000000" />
        <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center" Width="460"
                Background="{StaticResource Panel}" CornerRadius="8" Padding="38,36,38,32">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.5" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="Kicker" Style="{StaticResource Kicker}" FontSize="15" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource TextBase}" HorizontalAlignment="Left" FontSize="32" FontWeight="Bold"
                           Margin="0,8,0,0" Text="Indtast PIN" />

                <!-- What is typed, as dots -->
                <Border Height="64" Margin="0,22,0,0" CornerRadius="6" Background="{StaticResource Dark}"
                        BorderBrush="{StaticResource Rule}" BorderThickness="1">
                    <TextBlock x:Name="Dots" Style="{StaticResource TextBase}" FontSize="30" Foreground="{StaticResource Ink}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Message" Style="{StaticResource TextBase}" HorizontalAlignment="Left" TextAlignment="Left"
                           FontSize="17" Foreground="{StaticResource AlarmText}" Margin="0,12,0,0" MinHeight="24" TextWrapping="Wrap" />

                <UniformGrid x:Name="Keys" Columns="3" Margin="-6,8,-6,0">
                    <Button Style="{StaticResource Key}" Content="1" Click="OnDigit" />
                    <Button Style="{StaticResource Key}" Content="2" Click="OnDigit" />
                    <Button Style="{StaticResource Key}" Content="3" Click="OnDigit" />
                    <Button Style="{StaticResource Key}" Content="4" Click="OnDigit" />
                    <Button Style="{StaticResource Key}" Content="5" Click="OnDigit" />
                    <Button Style="{StaticResource Key}" Content="6" Click="OnDigit" />
                    <Button Style="{StaticResource Key}" Content="7" Click="OnDigit" />
                    <Button Style="{StaticResource Key}" Content="8" Click="OnDigit" />
                    <Button Style="{StaticResource Key}" Content="9" Click="OnDigit" />
                    <Button Style="{StaticResource Key}" ToolTip="Slet" Click="OnBack">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Text="&#xE750;" />
                    </Button>
                    <Button Style="{StaticResource Key}" Content="0" Click="OnDigit" />
                    <Button Style="{StaticResource Key}" Content="OK" Foreground="{StaticResource Dark}"
                            Background="{StaticResource Ok}" Click="OnOk" />
                </UniformGrid>
                <Button Style="{StaticResource Key}" Margin="0,14,0,0" Height="60" FontSize="22" Content="Annuller" Click="OnCancel" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
