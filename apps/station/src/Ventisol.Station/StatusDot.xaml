<!-- The dashboards' "alive indicator", redrawn from its Figma SVG: a 32px disc with a
     faint 0.5px outline, a soft drop shadow, and a white inner light along the top-left rim. -->
<UserControl x:Class="Ventisol.Station.StatusDot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self" Width="32" Height="32">
    <Grid>
        <!-- Outline, 5% black, 0.5px outside the disc -->
        <Ellipse Margin="-0.5" Fill="#0D000000" />

        <Ellipse Fill="{Binding Fill, ElementName=Self}">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="0.5" BlurRadius="5" Opacity="0.3" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- Inner shadow in white, offset 1,2 and blurred 1: the rim of the disc minus a copy moved down-right -->
        <Grid>
            <Grid.Clip>
                <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
            </Grid.Clip>
            <Path Fill="White">
                <Path.Data>
                    <CombinedGeometry GeometryCombineMode="Exclude">
                        <CombinedGeometry.Geometry1>
                            <RectangleGeometry Rect="-8,-8,48,48" />
                        </CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2>
                            <EllipseGeometry Center="17,18" RadiusX="16" RadiusY="16" />
                        </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                </Path.Data>
                <Path.Effect>
                    <BlurEffect Radius="2" />
                </Path.Effect>
            </Path>
        </Grid>
    </Grid>
</UserControl>
