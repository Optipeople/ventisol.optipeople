<Window x:Class="Ventisol.Station.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Ventisol.Station.ViewModels"
        xmlns:local="clr-namespace:Ventisol.Station"
        Title="Ventisol MES-skærm" Width="1600" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource Canvas}"
        FontFamily="{StaticResource Hanken}" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Frameless, but still resizable and snappable when not in kiosk mode -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <CubicEase x:Key="Out" EasingMode="EaseOut" />

        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Rule}" />
            <Setter Property="FontFamily" Value="{StaticResource Hanken}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="{TemplateBinding Background}" Padding="20,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarButtonPrimary" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Foreground" Value="{StaticResource Dark}" />
            <Setter Property="Background" Value="{StaticResource Ok}" />
        </Style>

        <!-- Corner grip for resizing a block in layout mode -->
        <Style x:Key="ResizeGrip" TargetType="Thumb">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Cursor" Value="SizeNWSE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Ellipse Width="32" Height="32" Fill="{StaticResource Ink}" />
                            <Path Data="M9,15 L15,9 M11,19 L19,11" Stroke="{StaticResource Dark}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="28" Height="28"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Remove a widget, top-right of its block in layout mode -->
        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Disc" Width="32" Height="32" Fill="{StaticResource Ink}" />
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Text="&#xE8BB;"
                                       Foreground="{StaticResource Dark}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Fill" Value="{StaticResource AlarmText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A line in the widget picker -->
        <Style x:Key="PickerItem" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="{StaticResource Hanken}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="14,11">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Rule}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Page dot: the dot itself is drawn by code -->
        <Style x:Key="DotButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Width="36" Height="36">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A station, built like the dashboard's machine panel: name, state, clock, then the number that matters. -->
        <DataTemplate DataType="{x:Type vm:StationViewModel}">
            <Grid Margin="10">
                <Border x:Name="Panel" CornerRadius="8" Background="{StaticResource Panel}">
                    <!-- Laid out at one size and only ever scaled down, so a small block still fits -->
                    <Viewbox Margin="24,20" StretchDirection="DownOnly">
                    <StackPanel Width="340">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextBase}" FontSize="24" Text="{Binding Name}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <local:StatusDot x:Name="Dot" Fill="{StaticResource Off}" VerticalAlignment="Center" Margin="0,2,14,0"
                                                 RenderTransformOrigin="0.5,0.5">
                                    <local:StatusDot.RenderTransform>
                                        <ScaleTransform />
                                    </local:StatusDot.RenderTransform>
                                </local:StatusDot>
                                <TextBlock x:Name="State" Style="{StaticResource TextBase}" FontSize="38" FontWeight="Bold" Text="Ledig" />
                            </StackPanel>
                            <TextBlock x:Name="Time" Style="{StaticResource Timer}" FontSize="24" Margin="0,6,0,0"
                                       Text="{Binding ElapsedText}" Visibility="Hidden" />
                        </StackPanel>

                        <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,26,0,0">
                            <Grid>
                                <StackPanel x:Name="Work" Visibility="Hidden">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform />
                                    </StackPanel.RenderTransform>
                                    <TextBlock Style="{StaticResource Kicker}" Text="ORDRE" />
                                    <TextBlock x:Name="Order" Style="{StaticResource Figures}" FontSize="96" FontWeight="Bold" Margin="0,-6,0,0"
                                               Foreground="{StaticResource OkText}" Text="{Binding OrderNumber}" />
                                    <TextBlock Style="{StaticResource TextBase}" FontSize="22" Foreground="{StaticResource Ink3}" Margin="0,-6,0,0"
                                               Text="{Binding DetailText}" />
                                </StackPanel>
                                <TextBlock x:Name="Hint" Style="{StaticResource TextBase}" FontSize="22" VerticalAlignment="Center"
                                           Foreground="{StaticResource Quiet}" Text="Scan et element" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    </Viewbox>
                </Border>

                <!-- The answer to a scan: a solid status tile over the panel, dark text on colour -->
                <Border x:Name="FlashOk" CornerRadius="8" Background="{StaticResource Ok}" Opacity="0" IsHitTestVisible="False">
                    <Viewbox x:Name="FlashOkBody" Margin="24,20" StretchDirection="DownOnly" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform><ScaleTransform /></Viewbox.RenderTransform>
                    <StackPanel Width="340">
                        <Path Data="M0,22 L18,40 L54,4" Stroke="{StaticResource Dark}" StrokeThickness="8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextBase}" FontSize="44" FontWeight="Bold" Margin="0,24,0,0"
                                   Foreground="{StaticResource Dark}" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding FlashTitle}" />
                        <TextBlock Style="{StaticResource TextBase}" FontSize="22" Margin="0,8,0,0" Foreground="{StaticResource Dark}"
                                   TextWrapping="Wrap" TextAlignment="Center" Text="{Binding FlashDetail}" />
                    </StackPanel>
                    </Viewbox>
                </Border>
                <Border x:Name="FlashWarn" CornerRadius="8" Background="{StaticResource Warn}" Opacity="0" IsHitTestVisible="False">
                    <Viewbox x:Name="FlashWarnBody" Margin="24,20" StretchDirection="DownOnly" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform><ScaleTransform /></Viewbox.RenderTransform>
                    <StackPanel Width="340">
                        <Path Data="M0,0 L0,34 M0,52 L0,53" Stroke="{StaticResource Dark}" StrokeThickness="9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextBase}" FontSize="44" FontWeight="Bold" Margin="0,24,0,0"
                                   Foreground="{StaticResource Dark}" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding FlashTitle}" />
                        <TextBlock Style="{StaticResource TextBase}" FontSize="22" Margin="0,8,0,0" Foreground="{StaticResource Dark}"
                                   TextWrapping="Wrap" TextAlignment="Center" Text="{Binding FlashDetail}" />
                    </StackPanel>
                    </Viewbox>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <!-- Work starts: the dot pulses once and the order rises into place -->
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="1.35" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="1.35" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="Work" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="Work" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="16" To="0" Duration="0:0:0.3" EasingFunction="{StaticResource Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="1.35" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="1.35" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="Hint" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Ok}" />
                    <Setter TargetName="State" Property="Text" Value="I gang" />
                    <Setter TargetName="Time" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Work" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Hint" Property="Visibility" Value="Hidden" />
                </DataTrigger>

                <!-- Later than IsBusy, so a missing scanner wins: red state and the alarm glow -->
                <DataTrigger Binding="{Binding ScannerConnected}" Value="False">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="1.35" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="1.35" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Alarm}" />
                    <Setter TargetName="State" Property="Text" Value="Ingen scanner" />
                    <Setter TargetName="Order" Property="Foreground" Value="{StaticResource Ink3}" />
                    <Setter TargetName="Hint" Property="Text" Value="Sæt scanneren i holderen" />
                    <Setter TargetName="Hint" Property="Foreground" Value="{StaticResource AlarmText}" />
                    <Setter TargetName="Panel" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{StaticResource AlarmGlow}" BlurRadius="28" ShadowDepth="0" Opacity="0.55" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsFlashOk}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FlashOk" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetName="FlashOkBody" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.92" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="FlashOkBody" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.92" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FlashOk" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFlashWarn}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FlashWarn" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetName="FlashWarnBody" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.92" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="FlashWarnBody" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.92" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FlashWarn" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource Canvas}" MouseLeftButtonDown="OnPageMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Caption line, as on the dashboards: where on the left, state and time on the right -->
        <DockPanel x:Name="Caption" Margin="52,26,52,6" Height="34" IsHitTestVisible="False">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Timer}" FontSize="17" VerticalAlignment="Center" Text="{Binding ClockText}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,1,8,0" />
                <TextBlock Style="{StaticResource TextBase}" FontSize="15" Foreground="{StaticResource Ink3}" Text="Demo, sender ikke" />
            </StackPanel>
            <TextBlock Style="{StaticResource TextBase}" FontSize="15" Foreground="{StaticResource Ink3}" HorizontalAlignment="Left"
                       VerticalAlignment="Center" Text="Montage · Ventisol, Vrå" />
        </DockPanel>

        <!-- In layout mode the caption becomes the instructions and the way out -->
        <DockPanel x:Name="EditBar" Margin="52,26,52,6" Height="34" Visibility="Collapsed">
            <Button DockPanel.Dock="Right" Style="{StaticResource BarButtonPrimary}" Content="Færdig" Click="OnEditDone" />
            <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Nulstil" Margin="0,0,10,0" Click="OnEditReset" />
            <Grid DockPanel.Dock="Right" Margin="0,0,10,0">
                <Button x:Name="AddButton" Style="{StaticResource BarButton}" Content="+ Tilføj widget" Click="OnAddWidget" />
                <Popup x:Name="Picker" PlacementTarget="{Binding ElementName=AddButton}" Placement="Bottom" VerticalOffset="8"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="8" BorderBrush="{StaticResource Rule}" BorderThickness="1">
                        <StackPanel x:Name="PickerItems" MinWidth="280" />
                    </Border>
                </Popup>
            </Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TextBase}" FontSize="16" FontWeight="Bold" Text="Tilpas layout" />
                <TextBlock Style="{StaticResource TextBase}" FontSize="16" Foreground="{StaticResource Quiet}" Text="  ·  " />
                <TextBlock x:Name="EditHint" Style="{StaticResource TextBase}" FontSize="16" Foreground="{StaticResource Ink3}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="42,10,42,0">
            <!-- The cells blocks snap to, only shown while arranging -->
            <UniformGrid x:Name="Guides" Rows="6" Columns="12" Visibility="Collapsed" IsHitTestVisible="False" />

            <!-- Stations, placed from the saved layout -->
            <Grid x:Name="StationsGrid" />

            <!-- While resizing: an outline that follows the pointer exactly, over the block that snaps -->
            <Canvas IsHitTestVisible="False">
                <Rectangle x:Name="Ghost" RadiusX="10" RadiusY="10" Stroke="{StaticResource Ink}" StrokeThickness="2"
                           StrokeDashArray="4 3" Fill="#14FFFFFF" Visibility="Collapsed" />
            </Canvas>

            <local:ReportsView x:Name="Reports" DataContext="{Binding Report}" Visibility="Collapsed" />
        </Grid>

        <!-- Page dots, as on the dashboards, and the logo that opens the menu -->
        <Grid Grid.Row="2" Height="64">
            <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button x:Name="LogoButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14"
                    Cursor="Hand" Focusable="False" ToolTip="Menu" Click="OnLogo">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="34" Height="34" CornerRadius="6" Background="Black">
                            <Image Source="{StaticResource OptipeopleRing}" Width="20" Height="20" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Panel}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- The menu slides in from the right; a tap beside it closes it -->
        <Grid x:Name="MenuLayer" Grid.RowSpan="3" Visibility="Collapsed">
            <Border x:Name="Scrim" Background="#99000000" MouseLeftButtonDown="OnScrim" />
            <Border HorizontalAlignment="Right" Width="500" Background="{StaticResource Panel}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MenuShift" />
                </Border.RenderTransform>
                <local:MenuPanel x:Name="Menu" />
            </Border>
        </Grid>
    </Grid>
</Window>
