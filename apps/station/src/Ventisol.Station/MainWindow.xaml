<Window x:Class="Ventisol.Station.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Ventisol.Station.ViewModels"
        xmlns:local="clr-namespace:Ventisol.Station"
        Title="Ventisol MES-skærm" Width="1600" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource Canvas}"
        FontFamily="{StaticResource Hanken}" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Frameless, but still resizable and snappable when not in kiosk mode -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <CubicEase x:Key="Out" EasingMode="EaseOut" />

        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Rule}" />
            <Setter Property="FontFamily" Value="{StaticResource Hanken}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="{TemplateBinding Background}" Padding="20,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarButtonPrimary" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Foreground" Value="{StaticResource Dark}" />
            <Setter Property="Background" Value="{StaticResource Ok}" />
        </Style>

        <!-- Corner grip for resizing a block in layout mode -->
        <Style x:Key="ResizeGrip" TargetType="Thumb">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Cursor" Value="SizeNWSE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Ellipse Width="32" Height="32" Fill="{StaticResource Ink}" />
                            <Path Data="M9,15 L15,9 M11,19 L19,11" Stroke="{StaticResource Dark}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="28" Height="28"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Remove a widget, top-right of its block in layout mode -->
        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Disc" Width="32" Height="32" Fill="{StaticResource Ink}" />
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Text="&#xE8BB;"
                                       Foreground="{StaticResource Dark}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Fill" Value="{StaticResource AlarmText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A line in the picker: a hidden station or a widget -->
        <Style x:Key="PickerItem" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="{StaticResource Hanken}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="14,11">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Rule}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Page dot: the dot itself is drawn by code -->
        <Style x:Key="DotButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Width="36" Height="36">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A station, built like the dashboard's machine panel: name, state, clock, then the number that matters. -->
        <DataTemplate DataType="{x:Type vm:StationViewModel}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- After the shift's end, while elements still run: the countdown to their stop, and
                     "Arbejder videre" (activity, a big touch target like the stop button). Scan station only. -->
                <Border Grid.Row="0" CornerRadius="8" Background="{StaticResource Warn}" Margin="0,0,0,8" Padding="16,8,8,8"
                        Visibility="{Binding ShowsShiftEndBand, Converter={x:Static vm:Present.Instance}}">
                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Stretch">
                        <Grid Width="420">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TextBase}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Left"
                                           Foreground="{StaticResource Dark}" Text="{Binding ShiftEndTitle}" />
                                <TextBlock Style="{StaticResource TextBase}" FontSize="16" HorizontalAlignment="Left"
                                           Foreground="{StaticResource Dark}" Text="{Binding ShiftEndText}" />
                            </StackPanel>
                            <Button Grid.Column="1" Height="56" MinWidth="150" Margin="12,0,0,0" Style="{StaticResource BarButton}"
                                    Background="{StaticResource Dark}" Foreground="{StaticResource Ink}" Click="OnTileWorkOn"
                                    Content="Arbejder videre" ToolTip="Start nedtællingen forfra" />
                        </Grid>
                    </Viewbox>
                </Border>

                <Border x:Name="Panel" Grid.Row="1" CornerRadius="8" Background="{StaticResource Panel}">
                    <Grid>
                    <!-- Laid out at one size and only ever scaled down, so a small block still fits -->
                    <Viewbox x:Name="Single" Margin="24,20" StretchDirection="DownOnly">
                    <StackPanel Width="340">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextBase}" FontSize="24" Text="{Binding Name}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <local:StatusDot x:Name="Dot" Fill="{StaticResource Off}" VerticalAlignment="Center" Margin="0,2,14,0"
                                                 RenderTransformOrigin="0.5,0.5">
                                    <local:StatusDot.RenderTransform>
                                        <ScaleTransform />
                                    </local:StatusDot.RenderTransform>
                                </local:StatusDot>
                                <TextBlock x:Name="State" Style="{StaticResource TextBase}" FontSize="38" FontWeight="Bold" Text="Ledig" />
                            </StackPanel>
                            <TextBlock x:Name="Time" Style="{StaticResource Timer}" FontSize="24" Margin="0,6,0,0"
                                       Text="{Binding ElapsedText}" Visibility="Hidden" />
                        </StackPanel>

                        <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,26,0,0">
                            <Grid>
                                <StackPanel x:Name="Work" Visibility="Hidden">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform />
                                    </StackPanel.RenderTransform>
                                    <TextBlock Style="{StaticResource Kicker}" Text="ORDRE" />
                                    <TextBlock x:Name="Order" Style="{StaticResource Figures}" FontSize="96" FontWeight="Bold" Margin="0,-6,0,0"
                                               Foreground="{StaticResource OkText}" Text="{Binding OrderNumber}" />
                                    <TextBlock Style="{StaticResource TextBase}" FontSize="22" Foreground="{StaticResource Ink3}" Margin="0,-6,0,0"
                                               Text="{Binding DetailText}" />
                                </StackPanel>
                                <TextBlock x:Name="Hint" Style="{StaticResource TextBase}" FontSize="22" VerticalAlignment="Center"
                                           Foreground="{StaticResource Quiet}"
                                           Text="{Binding DataContext.IdleText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <!-- Stopped at shift end: under the idle text until the next scan or shift start -->
                                <TextBlock Style="{StaticResource TextBase}" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                           Foreground="{StaticResource Warn}" Text="{Binding StoppedText}"
                                           Visibility="{Binding ShowsStoppedLine, Converter={x:Static vm:Present.Instance}}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    </Viewbox>

                    <!-- "Max i gang" above 1: the state over a row per element in progress, oldest first.
                         Each row is a slot of its own that scales to fill it; the slots are as many as the
                         max (up to six), so a row keeps its size as elements come and go. A tap on a row
                         opens that element's document (MainWindow.RowAt). -->
                    <DockPanel x:Name="Multi" Margin="20,14" Visibility="Collapsed">
                        <Viewbox DockPanel.Dock="Top" StretchDirection="DownOnly">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource TextBase}" FontSize="26" VerticalAlignment="Center" Margin="0,0,22,0" Text="{Binding Name}" />
                                <local:StatusDot x:Name="MultiDot" Fill="{StaticResource Off}" VerticalAlignment="Center" Margin="0,2,12,0" />
                                <TextBlock x:Name="MultiState" Style="{StaticResource TextBase}" FontSize="34" FontWeight="Bold" VerticalAlignment="Center" Text="Ledig" />
                            </StackPanel>
                        </Viewbox>
                        <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,2,0,0">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="1" Rows="{Binding RowSlots}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ActiveRowViewModel}">
                                            <Border Background="Transparent" Cursor="Hand" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
                                                <Viewbox Margin="0,2">
                                                    <Grid Width="400" Height="52">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Stops this element only, after the same confirm as the tile's -->
                                                        <Button Width="44" Height="44" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                Cursor="Hand" Focusable="False" ToolTip="Stop dette element" Click="OnTileStop"
                                                                Visibility="{Binding Station.StopOn, Converter={x:Static vm:Present.Instance}}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Grid Background="Transparent">
                                                                        <Ellipse x:Name="Ring" Width="32" Height="32" Stroke="{StaticResource Quiet}" StrokeThickness="2" />
                                                                        <Rectangle x:Name="Square" Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{StaticResource Quiet}" />
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AlarmText}" />
                                                                            <Setter TargetName="Square" Property="Fill" Value="{StaticResource AlarmText}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <TextBlock Grid.Column="1" Style="{StaticResource Figures}" FontSize="44" FontWeight="Bold" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource OkText}" Text="{Binding OrderNumber}" />
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0">
                                                            <TextBlock Style="{StaticResource TextBase}" FontSize="17" Foreground="{StaticResource Ink3}" HorizontalAlignment="Left"
                                                                       Text="{Binding DetailText}" />
                                                            <TextBlock x:Name="Mark" Style="{StaticResource TextBase}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Warn}"
                                                                       HorizontalAlignment="Left" Visibility="Collapsed" Text="{Binding Station.MarkText}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock x:Name="Clock" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Text="&#xE823;"
                                                                       Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" />
                                                            <TextBlock x:Name="RowTime" Style="{StaticResource Timer}" FontSize="26" Text="{Binding ElapsedText}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Viewbox>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <!-- In progress longer than "Marker efter": a forgotten element would take a share of the time -->
                                                <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                    <Setter TargetName="Clock" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="RowTime" Property="Foreground" Value="{StaticResource Warn}" />
                                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Viewbox x:Name="MultiHint" StretchDirection="DownOnly" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock x:Name="MultiHintText" Style="{StaticResource TextBase}" FontSize="22" Foreground="{StaticResource Quiet}"
                                                   Text="{Binding DataContext.IdleText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <TextBlock Style="{StaticResource TextBase}" FontSize="20" Margin="0,10,0,0" Foreground="{StaticResource Warn}"
                                                   Text="{Binding StoppedText}"
                                                   Visibility="{Binding ShowsStoppedLine, Converter={x:Static vm:Present.Instance}}" />
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </DockPanel>
                    </Grid>
                </Border>

                <!-- Opens the element's document; the way in for the demo, where a tap on the tile scans -->
                <Button Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Width="56" Height="56"
                        Cursor="Hand" Focusable="False" ToolTip="Produktionsliste" Click="OnTileDocument"
                        Visibility="{Binding DocumentsOn, Converter={x:Static vm:Present.Instance}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <TextBlock x:Name="Glyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Text="&#xE8A5;"
                                           Foreground="{StaticResource Quiet}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Ink}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Stops the element in progress by hand, after a confirm; only on a scan station -->
                <Button Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" Width="56" Height="56"
                        Cursor="Hand" Focusable="False" ToolTip="Stop ordren" Click="OnTileStop"
                        Visibility="{Binding ShowsStop, Converter={x:Static vm:Present.Instance}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Ellipse x:Name="Ring" Width="34" Height="34" Stroke="{StaticResource Quiet}" StrokeThickness="2" />
                                <Rectangle x:Name="Square" Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{StaticResource Quiet}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AlarmText}" />
                                    <Setter TargetName="Square" Property="Fill" Value="{StaticResource AlarmText}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- The answer to a scan: a solid status tile over the panel, dark text on colour -->
                <Border x:Name="FlashOk" Grid.RowSpan="2" CornerRadius="8" Background="{StaticResource Ok}" Opacity="0" IsHitTestVisible="False">
                    <Viewbox x:Name="FlashOkBody" Margin="24,20" StretchDirection="DownOnly" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform><ScaleTransform /></Viewbox.RenderTransform>
                    <StackPanel Width="340">
                        <Path Data="M0,22 L18,40 L54,4" Stroke="{StaticResource Dark}" StrokeThickness="8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextBase}" FontSize="44" FontWeight="Bold" Margin="0,24,0,0"
                                   Foreground="{StaticResource Dark}" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding FlashTitle}" />
                        <TextBlock Style="{StaticResource TextBase}" FontSize="22" Margin="0,8,0,0" Foreground="{StaticResource Dark}"
                                   TextWrapping="Wrap" TextAlignment="Center" Text="{Binding FlashDetail}" />
                    </StackPanel>
                    </Viewbox>
                </Border>
                <Border x:Name="FlashWarn" Grid.RowSpan="2" CornerRadius="8" Background="{StaticResource Warn}" Opacity="0" IsHitTestVisible="False">
                    <Viewbox x:Name="FlashWarnBody" Margin="24,20" StretchDirection="DownOnly" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform><ScaleTransform /></Viewbox.RenderTransform>
                    <StackPanel Width="340">
                        <Path Data="M0,0 L0,34 M0,52 L0,53" Stroke="{StaticResource Dark}" StrokeThickness="9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextBase}" FontSize="44" FontWeight="Bold" Margin="0,24,0,0"
                                   Foreground="{StaticResource Dark}" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding FlashTitle}" />
                        <TextBlock Style="{StaticResource TextBase}" FontSize="22" Margin="0,8,0,0" Foreground="{StaticResource Dark}"
                                   TextWrapping="Wrap" TextAlignment="Center" Text="{Binding FlashDetail}" />
                    </StackPanel>
                    </Viewbox>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <!-- Work starts: the dot pulses once and the order rises into place -->
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="1.35" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="1.35" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="Work" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="Work" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="16" To="0" Duration="0:0:0.3" EasingFunction="{StaticResource Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="1.35" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="1.35" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="Hint" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Ok}" />
                    <Setter TargetName="State" Property="Text" Value="I gang" />
                    <Setter TargetName="Time" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Work" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Hint" Property="Visibility" Value="Hidden" />
                </DataTrigger>

                <!-- "Max i gang" above 1: the rows instead of the one big order, idle or busy -->
                <DataTrigger Binding="{Binding IsMulti}" Value="True">
                    <Setter TargetName="Single" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Multi" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter TargetName="MultiDot" Property="Fill" Value="{StaticResource Ok}" />
                    <Setter TargetName="MultiState" Property="Text" Value="{Binding CountText}" />
                    <Setter TargetName="MultiHint" Property="Visibility" Value="Collapsed" />
                </DataTrigger>

                <!-- Later than IsBusy, so a missing scanner wins: red state and the alarm glow -->
                <DataTrigger Binding="{Binding ScannerConnected}" Value="False">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="1.35" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="1.35" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Alarm}" />
                    <Setter TargetName="State" Property="Text" Value="Ingen scanner" />
                    <Setter TargetName="Order" Property="Foreground" Value="{StaticResource Ink3}" />
                    <Setter TargetName="Hint" Property="Text" Value="Sæt scanneren i holderen" />
                    <Setter TargetName="Hint" Property="Foreground" Value="{StaticResource AlarmText}" />
                    <Setter TargetName="MultiDot" Property="Fill" Value="{StaticResource Alarm}" />
                    <Setter TargetName="MultiState" Property="Text" Value="Ingen scanner" />
                    <Setter TargetName="MultiHintText" Property="Text" Value="Sæt scanneren i holderen" />
                    <Setter TargetName="MultiHintText" Property="Foreground" Value="{StaticResource AlarmText}" />
                    <Setter TargetName="Panel" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{StaticResource AlarmGlow}" BlurRadius="28" ShadowDepth="0" Opacity="0.55" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsFlashOk}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FlashOk" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetName="FlashOkBody" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.92" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="FlashOkBody" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.92" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FlashOk" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFlashWarn}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FlashWarn" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetName="FlashWarnBody" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.92" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource Out}" />
                                <DoubleAnimation Storyboard.TargetName="FlashWarnBody" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.92" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FlashWarn" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.35" EasingFunction="{StaticResource Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource Canvas}" MouseLeftButtonDown="OnPageMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Caption line, as on the dashboards: where on the left, state and time on the right -->
        <DockPanel x:Name="Caption" Margin="52,26,52,6" Height="34" IsHitTestVisible="False">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Timer}" FontSize="17" VerticalAlignment="Center" Text="{Binding ClockText}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                <!-- The OptiCloud state, as in the menu -->
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Warn}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CloudHealth}" Value="Ok">
                                    <Setter Property="Fill" Value="{StaticResource Ok}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CloudHealth}" Value="Alarm">
                                    <Setter Property="Fill" Value="{StaticResource Alarm}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Style="{StaticResource TextBase}" FontSize="15" Foreground="{StaticResource Ink3}" Text="{Binding CloudText}"
                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
            </StackPanel>
            <TextBlock Style="{StaticResource TextBase}" FontSize="15" Foreground="{StaticResource Ink3}" HorizontalAlignment="Left"
                       VerticalAlignment="Center" Text="Montage · Ventisol, Vrå" />
        </DockPanel>

        <!-- A calm line when OptiCloud can't be reached: on a scan station that its scans wait safely,
             on a viewer how old its data is. Nothing when all is well. -->
        <Border x:Name="Banner" Grid.Row="1" Margin="52,4,52,2" Padding="20,12" CornerRadius="8" Background="{StaticResource Panel}"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BannerText}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,1,14,0" />
                <TextBlock Style="{StaticResource TextBase}" FontSize="19" Foreground="{StaticResource Ink2}" TextWrapping="Wrap"
                           Text="{Binding BannerText}" />
            </StackPanel>
        </Border>

        <!-- In layout mode the caption becomes the instructions and the way out -->
        <DockPanel x:Name="EditBar" Margin="52,26,52,6" Height="34" Visibility="Collapsed">
            <Button DockPanel.Dock="Right" Style="{StaticResource BarButtonPrimary}" Content="Færdig" Click="OnEditDone" />
            <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Nulstil" Margin="0,0,10,0" Click="OnEditReset" />
            <Grid DockPanel.Dock="Right" Margin="0,0,10,0">
                <Button x:Name="AddButton" Style="{StaticResource BarButton}" Content="+ Tilføj" Click="OnAddWidget" />
                <Popup x:Name="Picker" PlacementTarget="{Binding ElementName=AddButton}" Placement="Bottom" VerticalOffset="8"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="8" BorderBrush="{StaticResource Rule}" BorderThickness="1">
                        <StackPanel x:Name="PickerItems" MinWidth="280" />
                    </Border>
                </Popup>
            </Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TextBase}" FontSize="16" FontWeight="Bold" Text="Tilpas layout" />
                <TextBlock Style="{StaticResource TextBase}" FontSize="16" Foreground="{StaticResource Quiet}" Text="  ·  " />
                <TextBlock x:Name="EditHint" Style="{StaticResource TextBase}" FontSize="16" Foreground="{StaticResource Ink3}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2" Margin="42,10,42,0">
            <!-- The cells blocks snap to, only shown while arranging -->
            <UniformGrid x:Name="Guides" Rows="6" Columns="12" Visibility="Collapsed" IsHitTestVisible="False" />

            <!-- Stations, placed from the saved layout -->
            <Grid x:Name="StationsGrid" />

            <!-- While resizing: an outline that follows the pointer exactly, over the block that snaps -->
            <Canvas IsHitTestVisible="False">
                <Rectangle x:Name="Ghost" RadiusX="10" RadiusY="10" Stroke="{StaticResource Ink}" StrokeThickness="2"
                           StrokeDashArray="4 3" Fill="#14FFFFFF" Visibility="Collapsed" />
            </Canvas>

            <local:ReportsView x:Name="Reports" DataContext="{Binding Report}" Visibility="Collapsed" />
        </Grid>

        <!-- Page dots, as on the dashboards, and the logo that opens the menu -->
        <Grid Grid.Row="3" Height="64">
            <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button x:Name="LogoButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14"
                    Cursor="Hand" Focusable="False" ToolTip="Menu" Click="OnLogo">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="34" Height="34" CornerRadius="6" Background="Black">
                            <Image Source="{StaticResource OptipeopleRing}" Width="20" Height="20" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Panel}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- A station's element document, over the pages -->
        <local:DocumentOverlay x:Name="Document" Grid.RowSpan="4" />

        <!-- Asks before a station's element is stopped by hand; a tap beside it or Esc cancels -->
        <Grid x:Name="StopLayer" Grid.RowSpan="4" Visibility="Collapsed">
            <!-- On release, so the release does not land on the tile below once the layer is gone -->
            <Border Background="#99000000" MouseLeftButtonUp="OnStopScrim" />
            <Border x:Name="StopCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="760"
                    Background="{StaticResource Panel}" CornerRadius="8" Padding="44,40">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="StopStation" Style="{StaticResource Kicker}" FontSize="15" HorizontalAlignment="Left" />
                    <TextBlock x:Name="StopTitle" Style="{StaticResource TextBase}" HorizontalAlignment="Left" TextAlignment="Left"
                               FontSize="40" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="StopDetail" Style="{StaticResource TextBase}" HorizontalAlignment="Left" TextAlignment="Left"
                               FontSize="22" Foreground="{StaticResource Ink3}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,40,0,0">
                        <Button Style="{StaticResource ConfirmButton}" Content="Annuller" Click="OnStopCancel" />
                        <Button Style="{StaticResource ConfirmButton}" Content="Stop" Margin="16,0,0,0"
                                Background="{StaticResource Alarm}" Click="OnStopConfirm" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- The menu slides in from the right; a tap beside it closes it -->
        <Grid x:Name="MenuLayer" Grid.RowSpan="4" Visibility="Collapsed">
            <!-- Closes on release, and only for a press that began here: closing on the press would
                 let the release land on the tile underneath -->
            <Border x:Name="Scrim" Background="#99000000" MouseLeftButtonDown="OnScrimDown" MouseLeftButtonUp="OnScrimUp" />
            <Border HorizontalAlignment="Right" Width="500" Background="{StaticResource Panel}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MenuShift" />
                </Border.RenderTransform>
                <local:MenuPanel x:Name="Menu" />
            </Border>
        </Grid>
        <local:SetupView x:Name="Setup" Grid.RowSpan="4" />

        <!-- Asks before the app is closed from the tray, like the stop confirm; a tap beside it or Esc cancels -->
        <Grid x:Name="CloseLayer" Grid.RowSpan="4" Visibility="Collapsed">
            <Border Background="#99000000" MouseLeftButtonUp="OnCloseScrim" />
            <Border x:Name="CloseCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="760"
                    Background="{StaticResource Panel}" CornerRadius="8" Padding="44,40">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Style="{StaticResource Kicker}" FontSize="15" HorizontalAlignment="Left" Text="LUK" />
                    <TextBlock Style="{StaticResource TextBase}" HorizontalAlignment="Left" TextAlignment="Left"
                               FontSize="40" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap" Text="Luk MES-skærmen?" />
                    <TextBlock Style="{StaticResource TextBase}" HorizontalAlignment="Left" TextAlignment="Left"
                               FontSize="22" Foreground="{StaticResource Ink3}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Scanninger modtages ikke, før den startes igen." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,40,0,0">
                        <Button Style="{StaticResource ConfirmButton}" Content="Annullér" Click="OnCloseCancel" />
                        <Button Style="{StaticResource ConfirmButton}" Content="Luk" Margin="16,0,0,0"
                                Background="{StaticResource Alarm}" Click="OnCloseConfirm" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Asks for the setup PIN, when one is set; over everything else -->
        <local:PinPad x:Name="Pin" Grid.RowSpan="4" />
    </Grid>
</Window>
