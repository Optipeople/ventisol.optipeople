<!-- The setup screen: slides in from the right like the menu, over a dimmed screen. Sections are
     ruled rows under a small kicker, as in the menu; the stations are a ruled table, as on the report page.
     Nothing changes until "Gem". DataContext is the SetupViewModel, set by Open. -->
<UserControl x:Class="Ventisol.Station.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ventisol.Station.ViewModels"
             Visibility="Collapsed">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Shown" />

        <!-- Text, as in the menu and the report page -->
        <Style x:Key="Left" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource Left}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
        </Style>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Left}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Kicker}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
            <Setter Property="Margin" Value="0,36,0,8" />
        </Style>
        <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource Left}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,10" />
        </Style>

        <!-- Buttons, as on the layout bar -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Rule}" />
            <Setter Property="FontFamily" Value="{StaticResource Hanken}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="{TemplateBinding Background}" Padding="20,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarButtonPrimary" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Foreground" Value="{StaticResource Dark}" />
            <Setter Property="Background" Value="{StaticResource Ok}" />
        </Style>

        <!-- Fields: dark wells on the panel, ruled like the rest -->
        <Style x:Key="Well" TargetType="Control">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Dark}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource Hanken}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <ControlTemplate x:Key="WellTemplate" TargetType="Control">
            <Border x:Name="Bg" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                              Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Ink3}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="TextBox" BasedOn="{StaticResource Well}">
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Ink3}" />
            <Setter Property="Template" Value="{StaticResource WellTemplate}" />
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource Well}">
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Ink3}" />
            <Setter Property="Template" Value="{StaticResource WellTemplate}" />
        </Style>

        <!-- Dropdown: the well, a chevron, and a list like the widget picker -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="{StaticResource Hanken}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="14,11">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Rule}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource Well}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MaxDropDownHeight" Value="420" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bg" CornerRadius="6" Background="{StaticResource Dark}"
                                                BorderBrush="{StaticResource Rule}" BorderThickness="1">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Text="&#xE70D;"
                                                       Foreground="{StaticResource Ink3}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Ink3}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="13,0,38,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="6"
                                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                                <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="8" BorderBrush="{StaticResource Rule}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A thin scroll bar in the panel's own colours -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="{StaticResource Rule}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Two choices side by side: the chosen one lit, as Ink on the dark -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
            <Setter Property="FontFamily" Value="{StaticResource Hanken}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Ink}" />
                                <Setter Property="Foreground" Value="{StaticResource Dark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Track" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Rule}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Height" Value="44" />
        </Style>

        <!-- A card to choose, like "Tilpas layout" in the menu: the chosen one filled -->
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent" BorderBrush="{StaticResource Rule}"
                                BorderThickness="1" Padding="20,16">
                            <DockPanel>
                                <TextBlock x:Name="Check" DockPanel.Dock="Right" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                           Text="&#xE73E;" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Hidden" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Rule}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Ink3}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The answer to a check: a dot and a line, coloured by state -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,10,0" />
            <Setter Property="Fill" Value="{StaticResource Off}" />
        </Style>

        <!-- One station, a ruled row as on the report page -->
        <DataTemplate DataType="{x:Type vm:SetupStationViewModel}">
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="216" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="142" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource Left}" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Ink3}" Text="{Binding Number}" />
                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding NameFromMachine}"
                             ToolTip="{Binding NameTip}" />
                    <Border Grid.Column="3" Style="{StaticResource Track}">
                        <UniformGrid Columns="2">
                            <RadioButton Style="{StaticResource Segment}" Content="Montage"
                                         GroupName="{Binding Number, StringFormat=kind-{0}}" IsChecked="{Binding IsAssembly}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Pakning"
                                         GroupName="{Binding Number, StringFormat=kind-{0}}" IsChecked="{Binding IsPacking}" />
                        </UniformGrid>
                    </Border>
                    <ComboBox Grid.Column="5" ItemsSource="{Binding Owner.MaxActiveOptions}" SelectedItem="{Binding MaxActive}"
                              ToolTip="Max i gang: hvor mange elementer der må være i gang på stationen på én gang. 1: et nyt element stopper det, der er i gang." />
                    <ComboBox Grid.Column="7" ItemsSource="{Binding WorkModeOptions}" SelectedItem="{Binding WorkMode}"
                              ToolTip="Arbejdsform: Enkel er scan ind / scan ud. Session arbejder med kortene Start, Pause og Hold.">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <ComboBox Grid.Column="9" ItemsSource="{Binding Owner.Machines}" SelectedItem="{Binding Machine}" />
                    <ComboBox Grid.Column="11" ItemsSource="{Binding Owner.Scanners}" SelectedItem="{Binding Scanner}" />
                    <Button x:Name="IdentifyButton" Grid.Column="13" Style="{StaticResource BarButton}" Padding="0" Content="Identificér"
                            Command="{Binding IdentifyCommand}" Click="OnIdentify"
                            ToolTip="Scan en vilkårlig stregkode med stationens scanner" />

                    <StackPanel x:Name="NoteLine" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="13" Orientation="Horizontal" Margin="0,10,0,2">
                        <Ellipse x:Name="NoteDot" Style="{StaticResource StatusDot}" Fill="{StaticResource Ok}" />
                        <TextBlock x:Name="NoteText" Style="{StaticResource Small}" Foreground="{StaticResource OkText}" Text="{Binding Note}" />
                    </StackPanel>

                    <!-- Arbejdsform: a hint (Session with Max i gang 1), or the warning that Gem ends the elements on pause -->
                    <StackPanel x:Name="ModeLine" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="13" Orientation="Horizontal" Margin="0,10,0,2">
                        <Ellipse x:Name="ModeDot" Style="{StaticResource StatusDot}" Fill="{StaticResource Ink3}" />
                        <TextBlock x:Name="ModeText" Style="{StaticResource Small}" Text="{Binding WorkModeNote}" />
                    </StackPanel>

                    <!-- Vagtslut: where the station's shifts come from -->
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="13" Orientation="Horizontal" Margin="0,10,0,2">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE823;" Foreground="{StaticResource Ink3}"
                                   VerticalAlignment="Center" Margin="0,1,10,0" />
                        <TextBlock Style="{StaticResource Small}" Text="{Binding ShiftSource}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                    <Setter TargetName="NoteLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WorkModeNote}" Value="{x:Null}">
                    <Setter TargetName="ModeLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWorkModeWarning}" Value="True">
                    <Setter TargetName="ModeDot" Property="Fill" Value="{StaticResource Warn}" />
                    <Setter TargetName="ModeText" Property="Foreground" Value="{StaticResource Ink}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsIdentifying}" Value="True">
                    <Setter TargetName="IdentifyButton" Property="Content" Value="Stop" />
                    <Setter TargetName="IdentifyButton" Property="Background" Value="{StaticResource Ink}" />
                    <Setter TargetName="IdentifyButton" Property="Foreground" Value="{StaticResource Dark}" />
                    <Setter TargetName="NoteDot" Property="Fill" Value="{StaticResource Warn}" />
                    <Setter TargetName="NoteText" Property="Foreground" Value="{StaticResource Ink}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="Scrim" Background="#99000000" />
        <Border x:Name="Sheet" HorizontalAlignment="Right" Width="1180" Background="{StaticResource Panel}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SheetShift" />
            </Border.RenderTransform>

            <DockPanel Margin="36,32,36,28">
                <!-- Title and the way out, like the menu -->
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Width="44" Height="44" Cursor="Hand" Focusable="False" ToolTip="Annuller"
                            Command="{Binding CancelCommand}" VerticalAlignment="Top">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xE8BB;"
                                               Foreground="{StaticResource Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource Rule}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="Opsætning" />
                        <TextBlock Style="{StaticResource Small}" FontSize="16" Margin="0,2,0,0"
                                   Text="Gælder denne skærm. Intet ændres, før du trykker Gem." />
                    </StackPanel>
                </DockPanel>

                <!-- What stops a save (or why the last one failed), and the two ways out -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,8,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BarButtonPrimary}" Height="48" MinWidth="128" Content="Gem"
                                Command="{Binding SaveCommand}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Height="48" MinWidth="128" Margin="0,0,10,0"
                                Content="Annuller" Command="{Binding CancelCommand}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource Alarm}" />
                            <TextBlock Style="{StaticResource Left}" FontSize="16" Foreground="{StaticResource AlarmText}" Text="{Binding Notice}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" PreviewMouseWheel="OnScrollerWheel">
                    <StackPanel Margin="0,0,8,0">

                        <!-- ===== Skærmens rolle ===== -->
                        <TextBlock Style="{StaticResource Section}" Text="SKÆRMENS ROLLE" Margin="0,28,0,12" />
                        <UniformGrid Columns="2" Width="880" HorizontalAlignment="Left">
                            <RadioButton Style="{StaticResource Choice}" GroupName="mode" Margin="0,0,6,0" IsChecked="{Binding IsScanMode}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Text="&#xEE6F;"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Left}" FontWeight="Bold" Text="Scanstation" />
                                        <TextBlock Style="{StaticResource Small}" Text="Scannerne sidder her og sender til OptiCloud" />
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Choice}" GroupName="mode" Margin="6,0,0,0" IsChecked="{Binding IsViewerMode}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Text="&#xE7F4;"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Left}" FontWeight="Bold" Text="Visning" />
                                        <TextBlock Style="{StaticResource Small}" Text="Viser kun det, OptiCloud har" />
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>
                        </UniformGrid>

                        <!-- ===== Kiosk ===== -->
                        <!-- Kept in the autostart entry, so only the installed app can switch it. -->
                        <TextBlock Style="{StaticResource Section}" Text="KIOSK-TILSTAND" Margin="0,36,0,12" />
                        <UniformGrid Columns="2" Width="880" HorizontalAlignment="Left" IsEnabled="{Binding KioskAvailable}">
                            <UniformGrid.Style>
                                <Style TargetType="UniformGrid">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </UniformGrid.Style>
                            <RadioButton Style="{StaticResource Choice}" GroupName="kiosk" Margin="0,0,6,0" IsChecked="{Binding Kiosk}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Text="&#xE740;"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Left}" FontWeight="Bold" Text="Kiosk" />
                                        <TextBlock Style="{StaticResource Small}" Text="Hele skærmen, kan ikke lukkes ved et uheld" />
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Choice}" GroupName="kiosk" Margin="6,0,0,0" IsChecked="{Binding IsWindowMode}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Text="&#xE737;"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Left}" FontWeight="Bold" Text="Vindue" />
                                        <TextBlock Style="{StaticResource Small}" Text="Et almindeligt vindue, der kan lukkes" />
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Small}" Width="880" HorizontalAlignment="Left" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="{Binding KioskNote}" />

                        <!-- ===== OptiCloud ===== -->
                        <TextBlock Style="{StaticResource Section}" Text="OPTICLOUD" />
                        <StackPanel Width="880" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Left}" Width="220" Text="API-adresse" />
                                    <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Left}" Width="220" Text="Brugernavn" />
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Left}" Width="220" Text="Adgangskode" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Margin="10,0,0,0" Content="Glem"
                                            ToolTip="Slet den gemte adgangskode, når du trykker Gem"
                                            Command="{Binding ForgetPasswordCommand}"
                                            Visibility="{Binding CanForgetPassword, Converter={StaticResource Shown}}" />
                                    <Grid>
                                        <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />
                                        <TextBlock x:Name="PasswordHint" Style="{StaticResource Left}" FontSize="17" Foreground="{StaticResource Quiet}"
                                                   Margin="13,0,0,0" IsHitTestVisible="False" Text="{Binding PasswordHint}" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Left}" Width="220" Text="Konto-id" />
                                    <TextBox FontFamily="{StaticResource Mono}" FontSize="16" Text="{Binding AccountIdText, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </Border>
                            <DockPanel Margin="220,16,0,0">
                                <Button DockPanel.Dock="Left" Style="{StaticResource BarButton}" Content="Test forbindelse"
                                        Command="{Binding TestConnectionCommand}" />
                                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="None">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="Ok">
                                                        <Setter Property="Fill" Value="{StaticResource Ok}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="Error">
                                                        <Setter Property="Fill" Value="{StaticResource Alarm}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ConnectionText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Left}">
                                                <Setter Property="FontSize" Value="16" />
                                                <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="Ok">
                                                        <Setter Property="Foreground" Value="{StaticResource OkText}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="Error">
                                                        <Setter Property="Foreground" Value="{StaticResource AlarmText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

                        <!-- ===== Stationer ===== -->
                        <TextBlock Style="{StaticResource Section}" Text="STATIONER" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Opdatér scannere"
                                    ToolTip="Se efter scannere, der er sat i nu" Command="{Binding UpdateScannersCommand}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Margin="0,0,10,0" Content="Hent maskiner"
                                    ToolTip="Hent kontoens maskiner fra OptiCloud" Command="{Binding LoadMachinesCommand}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MachinesStatus}" Value="None">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MachinesStatus}" Value="Ok">
                                                    <Setter Property="Fill" Value="{StaticResource Ok}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MachinesStatus}" Value="Error">
                                                    <Setter Property="Fill" Value="{StaticResource Alarm}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding MachinesText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Left}">
                                            <Setter Property="FontSize" Value="16" />
                                            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MachinesStatus}" Value="None">
                                                    <Setter Property="Text" Value="Hent maskinerne for at vælge, hvilken maskine hver station er" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MachinesStatus}" Value="Ok">
                                                    <Setter Property="Foreground" Value="{StaticResource OkText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MachinesStatus}" Value="Error">
                                                    <Setter Property="Foreground" Value="{StaticResource AlarmText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <!-- Table head: same columns as a row -->
                        <Border Style="{StaticResource Row}" Padding="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="216" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="6*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="6*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="142" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Head}" Text="Nr." />
                                <TextBlock Grid.Column="1" Style="{StaticResource Head}" Text="Navn" />
                                <TextBlock Grid.Column="3" Style="{StaticResource Head}" Text="Type" />
                                <TextBlock Grid.Column="5" Style="{StaticResource Head}" Text="Max i gang" />
                                <TextBlock Grid.Column="7" Style="{StaticResource Head}" Text="Arbejdsform" />
                                <TextBlock Grid.Column="9" Style="{StaticResource Head}" Text="Maskine i OptiCloud" />
                                <TextBlock Grid.Column="11" Style="{StaticResource Head}" Text="Scanner" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Stations}" Focusable="False" />
                        <StackPanel Width="880" HorizontalAlignment="Left" Margin="0,16,0,0">
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Left}" Width="220" Text="Marker efter (timer)" />
                                    <ComboBox Width="120" HorizontalAlignment="Left" ItemsSource="{Binding MarkAfterOptions}" SelectedItem="{Binding MarkAfterHours}" />
                                </DockPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Small}" Margin="220,16,0,0" TextWrapping="Wrap"
                                       Text="På en station med Max i gang over 1 markeres et element, der har været i gang længere end det. Et glemt element ville ellers tage en del af stationens tid." />
                        </StackPanel>

                        <!-- ===== Vagtslut (docs/plan-shift-end.md §3.3) ===== -->
                        <TextBlock Style="{StaticResource Section}" Text="VAGTSLUT" />
                        <StackPanel Width="880" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Left}" Width="220" Text="Stop ved vagtslut" />
                                    <Border Style="{StaticResource Track}" Width="216" HorizontalAlignment="Left">
                                        <UniformGrid Columns="2">
                                            <RadioButton Style="{StaticResource Segment}" Content="Til" GroupName="shiftend" IsChecked="{Binding ShiftEndOn}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="Fra" GroupName="shiftend" IsChecked="{Binding IsShiftEndOff}" />
                                        </UniformGrid>
                                    </Border>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Left}" Width="220" Text="Vent efter vagtslut (min)" />
                                    <ComboBox Width="120" HorizontalAlignment="Left" ItemsSource="{Binding GraceOptions}" SelectedItem="{Binding ShiftEndGraceMinutes}"
                                              IsEnabled="{Binding ShiftEndOn}" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Left}" Width="220" Text="Standardvagt (man–fre)" />
                                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding ShiftEndOn}">
                                        <ComboBox Width="120" ItemsSource="{Binding ShiftTimeOptions}" SelectedItem="{Binding ShiftStart}" ToolTip="Vagtens start" />
                                        <TextBlock Style="{StaticResource Left}" Margin="12,0" Text="til" />
                                        <ComboBox Width="120" ItemsSource="{Binding ShiftTimeOptions}" SelectedItem="{Binding ShiftEnd}" ToolTip="Vagtens slut" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="220,16,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShiftNote}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource Warn}" />
                                <TextBlock Style="{StaticResource Small}" Foreground="{StaticResource Ink}" Text="{Binding ShiftNote}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Small}" Margin="220,16,0,0" TextWrapping="Wrap"
                                       Text="Elementer, der stadig er i gang, stoppes ved vagtens slut, når der ikke er sket noget på stationen i ventetiden. Standardvagt Ingen: stationen stoppes ikke." />
                        </StackPanel>

                        <!-- ===== Ordredokumenter ===== -->
                        <TextBlock Style="{StaticResource Section}" Text="ORDREDOKUMENTER" />
                        <StackPanel Width="880" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Left}" Width="220" Text="Mappe med ordredokumenter" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding DocumentsFolder, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Mappen, hvor 3E lægger ordrernes PDF'er, f.eks. R:\Indkøb\Shares\Ordre. Tom: ordredokumenterne hentes fra OptiCloud, som scan-PC'erne lægger dem i (til en PC, der ikke kan nå drevet). Uden OptiCloud er de slået fra." />
                                </DockPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="220,16,0,0" VerticalAlignment="Center">
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DocumentsStatus}" Value="None">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentsStatus}" Value="Ok">
                                                    <Setter Property="Fill" Value="{StaticResource Ok}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentsStatus}" Value="Error">
                                                    <Setter Property="Fill" Value="{StaticResource Alarm}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding DocumentsText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Left}">
                                            <Setter Property="FontSize" Value="16" />
                                            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DocumentsStatus}" Value="None">
                                                    <Setter Property="Text" Value="Tom: ordredokumenterne hentes fra OptiCloud (slået fra uden OptiCloud)" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentsStatus}" Value="Ok">
                                                    <Setter Property="Foreground" Value="{StaticResource OkText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentsStatus}" Value="Error">
                                                    <Setter Property="Foreground" Value="{StaticResource AlarmText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- ===== PIN-kode ===== -->
                        <!-- Optional. Shown as typed, not as dots: a PIN typed wrong here would lock the setup. -->
                        <TextBlock Style="{StaticResource Section}" Text="PIN-KODE" />
                        <StackPanel Width="880" HorizontalAlignment="Left" Margin="0,0,0,28">
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Left}" Width="220" Text="PIN til opsætning" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Margin="10,0,0,0" Content="Fjern"
                                            ToolTip="Fjern PIN-koden, når du trykker Gem"
                                            Command="{Binding ForgetPinCommand}"
                                            Visibility="{Binding CanRemovePin, Converter={StaticResource Shown}}" />
                                    <Grid>
                                        <TextBox FontFamily="{StaticResource Mono}" MaxLength="8" InputScope="Number"
                                                 PreviewTextInput="OnPinTextInput"
                                                 Text="{Binding NewPin, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock FontSize="17" Margin="13,0,0,0" IsHitTestVisible="False" Text="{Binding PinHint}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Left}">
                                                    <Setter Property="Foreground" Value="{StaticResource Quiet}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NewPin}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Small}" Margin="220,16,0,0" TextWrapping="Wrap"
                                       Text="Med en PIN skal den tastes for at åbne Opsætning. Uden PIN kan alle åbne den." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
