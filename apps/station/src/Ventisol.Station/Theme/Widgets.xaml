<!-- Widgets: blocks that sit among the stations. Same panel as a station, so the screen reads as one.
     Single values are laid out at one size and only scaled down, like the stations. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Ventisol.Station.ViewModels"
                    xmlns:local="clr-namespace:Ventisol.Station">

    <Style x:Key="WidgetPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="10" />
    </Style>

    <!-- Clock: a railway station clock on a white tile, the one light block on the screen -->
    <DataTemplate DataType="{x:Type vm:ClockWidget}">
        <Border Style="{StaticResource WidgetPanel}" Background="White">
            <local:ClockFace Margin="18" />
        </Border>
    </DataTemplate>

    <!-- One number: what it is, the number, how it is counted -->
    <DataTemplate DataType="{x:Type vm:KpiWidget}">
        <Border Style="{StaticResource WidgetPanel}">
            <Viewbox Margin="24,18" StretchDirection="DownOnly">
                <StackPanel Width="240">
                    <TextBlock Style="{StaticResource TextBase}" FontSize="24" Text="{Binding Label}" />
                    <TextBlock Style="{StaticResource Figures}" FontSize="96" FontWeight="Bold" Margin="0,-4,0,0" Text="{Binding Value}" />
                    <TextBlock Style="{StaticResource TextBase}" FontSize="18" Foreground="{StaticResource Ink3}" Margin="0,-6,0,0"
                               Text="{Binding Note}" />
                </StackPanel>
            </Viewbox>
        </Border>
    </DataTemplate>

    <!-- The last ten orders, as a ruled table like the report page; rows that don't fit are cut, not shrunk -->
    <DataTemplate DataType="{x:Type vm:RecentOrdersWidget}">
        <Border Style="{StaticResource WidgetPanel}" Padding="28,24,28,0" ClipToBounds="True">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBase}" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Left" Margin="0,0,0,10" Text="SENESTE ORDRER" />
                <Grid>
                    <TextBlock x:Name="Empty" Style="{StaticResource TextBase}" FontSize="17" Foreground="{StaticResource Quiet}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0" Text="Ingen ordrer endnu i dag" Visibility="Collapsed" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecentOrderRow}">
                                <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Figures}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Left"
                                                   Text="{Binding Order}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                                            <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,1,9,0" VerticalAlignment="Center"
                                                     Fill="{StaticResource Ok}" Visibility="Collapsed" />
                                            <TextBlock x:Name="Where" Style="{StaticResource TextBase}" FontSize="17" HorizontalAlignment="Left"
                                                       Foreground="{StaticResource Ink3}" Text="{Binding Where}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource Figures}" FontSize="17" Text="{Binding Total}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Active}" Value="True">
                                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Where" Property="Foreground" Value="{StaticResource Ink}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DockPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                <Setter TargetName="Empty" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
