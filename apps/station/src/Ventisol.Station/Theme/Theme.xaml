<!-- Optipeople product language, dark, after the 2026 dashboard redesign
     (context/opti-factory-dashboard-165-1680.html): grey canvas, near-black panels,
     solid status tiles with dark text, Hanken Grotesk, timers in IBM Plex Mono. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Hanken">pack://application:,,,/Fonts/#Hanken Grotesk, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">pack://application:,,,/Fonts/#IBM Plex Mono, Consolas</FontFamily>

    <!-- Grounds -->
    <SolidColorBrush x:Key="Canvas" Color="#243535" />
    <SolidColorBrush x:Key="Panel" Color="#112222" />
    <SolidColorBrush x:Key="Rule" Color="#364646" />

    <!-- Ink on dark -->
    <SolidColorBrush x:Key="Ink" Color="#F6FAFA" />
    <SolidColorBrush x:Key="Ink2" Color="#EAEEEE" />
    <SolidColorBrush x:Key="Ink3" Color="#AAB5B5" />
    <SolidColorBrush x:Key="Quiet" Color="#5D6B6B" />
    <SolidColorBrush x:Key="Dark" Color="#071818" />

    <!-- Status: these mean state, never decoration -->
    <SolidColorBrush x:Key="Ok" Color="#37C245" />
    <SolidColorBrush x:Key="OkText" Color="#7AD483" />
    <SolidColorBrush x:Key="Warn" Color="#FFA740" />
    <SolidColorBrush x:Key="Alarm" Color="#C25037" />
    <SolidColorBrush x:Key="AlarmText" Color="#DA8572" />
    <SolidColorBrush x:Key="Off" Color="#758585" />
    <Color x:Key="AlarmGlow">#F0715A</Color>

    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hanken}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Figures" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- Running clocks, like the dashboard's machine timers -->
    <Style x:Key="Timer" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Ink3}" />
    </Style>

    <!-- Small bold label over a big number -->
    <Style x:Key="Kicker" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    </Style>

    <!-- A confirm's buttons: big, as on the document's "Luk", for a thumb at arm's length -->
    <Style x:Key="ConfirmButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Rule}" />
        <Setter Property="FontFamily" Value="{StaticResource Hanken}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="76" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}" Padding="30,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Hanken}" />
    </Style>
</ResourceDictionary>
