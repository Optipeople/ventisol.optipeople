<!-- A station's element document over the whole stations page, opened by a tap on the station.
     Closes with "Luk", Esc, or by itself after some minutes untouched (MainWindow). Scans go on as
     always while it is open; their answers show as a strip at the bottom, as the tiles are covered. -->
<UserControl x:Class="Ventisol.Station.DocumentOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ventisol.Station.ViewModels"
             xmlns:local="clr-namespace:Ventisol.Station"
             Visibility="Collapsed">
    <UserControl.Resources>
        <!-- Big and plain: an operator's thumb finds it at arm's length -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="24,0,0,0" />
            <Setter Property="ToolTip" Value="Luk (Esc)" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="{StaticResource Rule}" Height="76" Padding="30,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Text="&#xE8BB;"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBlock Style="{StaticResource TextBase}" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Text="Luk" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource Canvas}">
        <local:OrderDocumentView x:Name="View" Margin="24">
            <local:OrderDocumentView.Actions>
                <Button Style="{StaticResource CloseButton}" Click="OnClose" />
            </local:OrderDocumentView.Actions>
        </local:OrderDocumentView>

        <!-- The answer to a scan at any station, as on its tile: dark text on the status colour -->
        <ItemsControl x:Name="Scans" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:StationViewModel}">
                    <Border x:Name="Pill" CornerRadius="8" Padding="32,18" Margin="0,8,0,0" Visibility="Collapsed" Background="{StaticResource Ok}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.5" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TextBase}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Dark}" Text="{Binding Name}" />
                            <TextBlock Style="{StaticResource TextBase}" FontSize="26" Foreground="{StaticResource Dark}" Text="  ·  " />
                            <TextBlock Style="{StaticResource TextBase}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Dark}" Text="{Binding FlashTitle}" />
                            <TextBlock Style="{StaticResource TextBase}" FontSize="22" Foreground="{StaticResource Dark}" Margin="20,0,0,0"
                                       VerticalAlignment="Center" Text="{Binding FlashDetail}" />
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsFlashOk}" Value="True">
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFlashWarn}" Value="True">
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource Warn}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
