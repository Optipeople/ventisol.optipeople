# Optipeople API: login (POST /api/Authentication/login) and the scan reads.
# Point at https://api-staging.optipeople.dk to sign in with staging accounts.
OPTIPEOPLE_API_URL=https://api.optipeople.dk

# Ventisol's OptiCloud account id (uuid). Users in this account get in, and
# super administrators from any account read this account's scans.
VENTISOL_ACCOUNT_ID=

# Public address of this site, for links in emails (the password reset).
# Never taken from the request's Host header. http://localhost:3000 in dev.
SITE_URL=https://ventisol.optipeople.dk

# Dev only: serve sample scans from fixtures/scans.json and skip the login on
# the report pages. Ignored in production builds (NODE_ENV=production).
# VENTISOL_FIXTURES=1

# Pooled Postgres connection string of the Supabase project ventisol-portal
# (transaction pooler, port 6543). Server only: never NEXT_PUBLIC. On Vercel
# the Supabase integration sets POSTGRES_URL, which is read when DATABASE_URL
# is empty. With neither set, the portal pages fail unless VENTISOL_FIXTURES=1
# (then an in-process PGlite with the migrations is used).
DATABASE_URL=
# POSTGRES_URL=

# The OptiCloud service account that reads scans and order documents for the
# sync job (lib/sync). Server only.
OPTICLOUD_SERVICE_USER=
OPTICLOUD_SERVICE_PASSWORD=

# Vercel Cron sends this as "Authorization: Bearer <value>" to app/api/cron/*.
# Vercel sets it in production; choose any long random string locally.
CRON_SECRET=

# AI Gateway key for the chat. Not needed on Vercel, where OIDC is used.
AI_GATEWAY_API_KEY=
